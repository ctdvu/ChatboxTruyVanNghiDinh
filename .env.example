# Tùy chọn: dùng Groq để tạo câu trả lời tự nhiên từ các trích đoạn RAG.
# Lấy khóa tại https://console.groq.com/keys, không đưa khóa này lên Git.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Thư mục lưu chỉ mục và lịch sử. Với Render free, SQLite là tạm thời sau redeploy.
APP_DATA_DIR=storage
